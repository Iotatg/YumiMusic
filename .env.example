# ── YumiMusic runtime config ──────────────────────────────────────────────────
TOKEN=
API_ID=
API_HASH=
OWNER_ID=

# Music providers
IOTA_API_URL=http://127.0.0.1:8014
IOTA_API_KEY=

# Assistant (voice-chat userbot) — Pyrogram hex or MadelineProto base64url

# ── YumiMusic runtime config ──────────────────────────────────────────────────
TOKEN=
API_ID=
API_HASH=
OWNER_ID=

# Music providers
IOTA_API_URL=http://127.0.0.1:8014
IOTA_API_KEY=

# Assistant (voice-chat userbot) — Pyrogram hex or MadelineProto base64url
STRING_SESSIONS=

# Streaming master switch
VC_ENABLED=on

# ── RiteshApi (api.riteshyt.in) — optional second provider ──
RITESH_ENABLED=true
RITESH_API_URL=https://api.riteshyt.in
RITESH_API_KEY=

# ── AI chatbot ──
# Any OpenAI-compatible endpoint. The first configured set wins.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_FALLBACK_MODEL=
# APINEX_API_KEY=
# APINEX_API_URL=https://api.apinex.bond/v1
# APINEX_MODEL=free/gemini-3.8-flash
# APINEX_FALLBACK_MODEL=free/gpt-6-luna
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
CHATBOT_ENABLED=true
# Log why a group message was ignored (useful when a bot seems deaf).
# CHATBOT_DEBUG=1
# Provider quota: calls per minute for the account (apinex free = 5).
# CHATBOT_RPM=5
# Words that count as addressing her in groups (comma separated).
# CHATBOT_TRIGGER=yumi
# Optional persona override (file wins over CHATBOT_PERSONA).
# CHATBOT_PERSONA_FILE=data/persona.txt
# Her identity — baked into the persona, overridable without touching code.
BOT_AGE=20
BOT_FROM=Delhi
BOT_DOB=14 February
OWNER_NAME=ɴᴏᴛʜɪɴɢ
OWNER_USERNAME=im_ntg
